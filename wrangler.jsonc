{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "videoprompt",
  "compatibility_date": "2026-07-08",
  "main": "worker.js",
  "assets": {
    "directory": "docs",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "videoprompt-models"
    }
  ],
  "compatibility_flags": ["nodejs_compat"]
}
